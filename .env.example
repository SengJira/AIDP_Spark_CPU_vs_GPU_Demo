# AIDP Spark CPU vs GPU demo — copy to .env (chmod 600, gitignored).
# NEVER commit .env or any credentials file.
# Alternatively ~/.cnc-demo-credentials (legacy lab names) is picked up
# automatically by scripts/lib.sh.

# --- Dell ObjectScale (S3) ---
OBS_ENDPOINT=http://172.18.11.31:9020
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
# lab credential-file equivalents: S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY

# --- Data Processing Engine (Spark) ---
DPE_API_ENDPOINT=https://ddpe-http.ddpe.lab9bgp.com
DPE_CLI=$HOME/jirawut/dell-data-processing-engine/bin/dell-data-processing-engine
# The bundled CLI requires Java >= 22. Point at any newer JDK:
DPE_JAVA_HOME=/home/betalab/workspace/tk/openjdk/jdk-27
DPE_USER=
DPE_PASSWORD=
DPE_ROLE=jirawut_demo
# lab credential-file equivalents: TRINO_USER, TRINO_PASS

# --- Resource pools (verified via `instance list`) ---
CPU_POOL=default
GPU_POOL=NVIDIA-L4

# --- Storage bucket ---
# NOTE: the lab IAM keys cannot create buckets (AccessDenied on CreateBucket),
# so the demo defaults to the existing writable 'js-demo' bucket and uses the
# aidp-demo/ prefix inside it.
DEMO_BUCKET=js-demo

# --- Data Analytics Engine (Starburst/Trino) ---
DDAE_HOST=ddae.lab9bgp.com
DDAE_USER=
DDAE_PASSWORD=
# lab credential-file equivalents: TRINO_USER, TRINO_PASS

# --- Scale ---
ROWS=100000000
